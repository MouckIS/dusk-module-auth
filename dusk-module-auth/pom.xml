<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dusk</groupId>
        <artifactId>dusk-module-parent</artifactId>
        <version>1.2.0</version>
        <relativePath/>
    </parent>

    <artifactId>dusk-module-auth</artifactId>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--        用于flyway 插件迁移自定义迁移表名-->
        <flyway.table>flyway_schema_history_auth</flyway.table>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.dusk</groupId>
            <artifactId>dusk-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dusk</groupId>
            <artifactId>dusk-common-rpc</artifactId>
        </dependency>

        <!-- 权限注册的 MQ 通道（方案 3.6 / 3.7 事件 #1）：消费 SDK 投递的 RESOURCE_SNAPSHOT_REGISTER。
             版本由 dusk-dependencies BOM 管理；消费者默认关闭，见 app.registry.mq.enabled。 -->
        <dependency>
            <groupId>com.dusk</groupId>
            <artifactId>dusk-common-mqs</artifactId>
        </dependency>

        <dependency>
            <groupId>com.dusk</groupId>
            <artifactId>dusk-module-auth-shared</artifactId>
        </dependency>

        <dependency>
            <groupId>com.dusk</groupId>
            <artifactId>dusk-module-metadata-shared</artifactId>
        </dependency>

        <dependency>
            <groupId>com.dusk</groupId>
            <artifactId>dusk-module-notification-shared</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.github.whvcse</groupId>
            <artifactId>easy-captcha</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.binarywang</groupId>
            <artifactId>weixin-java-miniapp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
        </dependency>

        <dependency>
            <groupId>com.hankcs</groupId>
            <artifactId>hanlp</artifactId>
        </dependency>

        <!-- 版本由 dusk-dependencies BOM 统一抬升（RocketMQ 传递带入 1.19.0，
             1.15 起解决 Base64 decode 最后字符错误问题） -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>

        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20260814</version>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- 测试依赖：由 dusk-module-parent 统一引入 spring-boot-starter-test
             （已含 JUnit 5 / Mockito / Mockito-JUnit-Jupiter / AssertJ），此处不再重复声明 -->
    </dependencies>

    <build>
        <plugins>
            <!-- 单元测试执行：排除需要真实中间件（PostgreSQL/Nacos/Redis）的集成测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/CruxModuleAuthApplicationTests.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- JaCoCo for Code Coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- 分支覆盖率检查 -->
                    <execution>
                        <id>jacoco-check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.dusk.module.auth.service.impl</include>
                                        <include>com.dusk.module.auth.common.util</include>
                                    </includes>
                                    <limits>
                                        <!-- 分支覆盖率最小60% -->
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                        <!-- 行覆盖率最小70% -->
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <id>github-dusk-module-parent</id>
            <url>https://maven.pkg.github.com/mouckis/dusk-module-parent</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>github-dusk-common</id>
            <url>https://maven.pkg.github.com/mouckis/dusk-common</url>
        </repository>
        <repository>
            <id>github-dusk-module-metadata</id>
            <url>https://maven.pkg.github.com/mouckis/dusk-module-metadata</url>
        </repository>
    </repositories>
    <distributionManagement>
        <repository>
            <id>github-dusk-module-auth</id>
            <url>https://maven.pkg.github.com/mouckis/dusk-module-auth</url>
        </repository>
    </distributionManagement>
</project>
